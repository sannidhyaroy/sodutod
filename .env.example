# Discord bot token — https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Server (guild) ID — enable Developer Mode (Settings → Advanced), right-click server icon → Copy Server ID
GUILD_ID=

# Role IDs — Server Settings → Roles → right-click role → Copy Role ID
# Role assigned on join, before verification
ROLE_UNVERIFIED_ID=
# Role granted when the member agrees to the rules (swapped for the one above)
ROLE_MEMBER_ID=

# Channel IDs — right-click channel → Copy Channel ID
# Channel hosting the rules and the verification button
CHANNEL_RULES_ID=
# Channel for welcome messages (used when WELCOME_MODE=roster or public)
CHANNEL_WELCOME_ID=
# Channel for release announcements
CHANNEL_RELEASES_ID=
# Channel for the bot's operational telemetry
CHANNEL_TELEMETRY_ID=

# GitHub repo to watch for releases and issue lookups
GITHUB_REPO=sannidhyaroy/Soduto
# Optional: raises the API rate limit from 60/h to 5000/h. A fine-grained PAT
# with read-only Contents + Issues is enough.
GITHUB_TOKEN=
# How often to check for new releases, in seconds
RELEASE_POLL_SECONDS=300

# Directory for the bot's small state file. docker-compose overrides this to /data.
STATE_DIR=./data

# Markdown file posted into the rules channel by /post-rules
RULES_PATH=./rules.md

# Presence on the bot's profile: ACTIVITY_TYPE is one of playing, streaming,
# listening, watching, competing, custom. Discord renders it as
# "<Type> <text>", e.g. "Listening to port 1716". ACTIVITY_URL is only used
# for streaming (must be a Twitch/YouTube URL to get the purple status).
ACTIVITY_TYPE=listening
ACTIVITY_TEXT=port 1716
ACTIVITY_URL=

# Telemetry verbosity in the telemetry channel:
#   verbose — mirror every bot action (joins, roster updates, DMs) (default)
#   normal  — only significant events (verifications, announcements, misconfigurations)
TELEMETRY_LEVEL=verbose

# How to greet new members:
#   roster — exactly one welcome message in the welcome channel mentioning
#            everyone not yet verified: reposted on join (pinging only the
#            newcomer), silently edited as members verify or leave, deleted
#            once nobody is pending (default)
#   dm     — personal message to the joiner
#   public — one embed per join in the welcome channel
#   off    — rely on Discord's own join messages
WELCOME_MODE=roster
